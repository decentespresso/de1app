package require tcltest 2
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
# Load exact production procs without starting the GUI/BLE/application packages.
proc load_procs {path names} {
    set f [open $path]; set text [read $f]; close $f
    set command ""
    foreach line [split $text \n] {
        append command $line \n
        if {![info complete $command]} {continue}
        if {[regexp {^\s*proc\s+(\S+)} $command -> name] && $name in $names} {
            uplevel #0 $command
        }
        set command ""
    }
}
namespace eval ::plugins::shot_upload {}
load_procs [file join $root de1plus plugins shot_upload plugin.tcl] {
    ::plugins::shot_upload::post_json ::plugins::shot_upload::_data_dir
}
proc ifexists {varname} {upvar $varname v; if {[info exists v]} {return $v}; return ""}
set ::test_home /test/home
proc homedir {} {return $::test_home}
array set ::settings {decent_login_email a@example.com decent_login_password_encrypted pw}

# A shot body with accented text and characters >= 0x80, the case v0.5 broke.
set json "{\"title\":\"Rao Allongé café ü\",\"pad\":\"[string repeat x 2000]\"}"
set json_bytes [encoding convertto utf-8 $json]
set have_curl [expr {![catch {package require TclCurl}]}]
testConstraint tclcurl $have_curl
testConstraint nocurl [expr {!$have_curl}]
testConstraint tclsh [expr {[auto_execok tclsh8.6] ne "" || [auto_execok tclsh] ne ""}]

# --- ::http fallback (plain tclsh has no TclCurl) ---------------------------------
package require http
proc ::http::geturl {url args} {set ::request [list $url $args]; return tok1}
proc ::http::ncode {tok} {return 200}
proc ::http::data {tok} {return {{"ok":true}}}
proc ::http::cleanup {tok} {}

test shot-upload-fallback-gzip {fallback sends gzip of the UTF-8 JSON, labelled} -constraints nocurl -body {
    set r [::plugins::shot_upload::post_json http://example.invalid/support/api/shot_upload $json]
    set opts [lindex $::request 1]
    list [dict get $r ncode] [expr {[zlib gunzip [dict get $opts -query]] eq $json_bytes}] \
        [dict get [dict get $opts -headers] Content-Encoding] [dict get $opts -type]
} -result {200 1 gzip {application/json; charset=utf-8}}

# --- data dir fallback --------------------------------------------------------------
test shot-upload-data-dir-fallback {older cores without data_directory use homedir} -body {
    catch {rename ::data_directory {}}
    ::plugins::shot_upload::_data_dir
} -result /test/home

test shot-upload-data-dir {newer cores use data_directory} -body {
    proc ::data_directory {} {return /test/data}
    set d [::plugins::shot_upload::_data_dir]
    rename ::data_directory {}
    set d
} -result /test/data

# --- TclCurl: the bytes that reach a real HTTP server ----------------------------
# The server runs in a separate tclsh, because curl perform blocks this event loop.
# It writes the raw request body and the Content-Encoding header to files.
proc start_server {} {
    set dir [temporaryDirectory]
    set ::srv_body [file join $dir shot_upload_body.bin]
    set ::srv_ce   [file join $dir shot_upload_ce.txt]
    set ::srv_script [file join $dir shot_upload_srv.tcl]
    set ::srv_port [file join $dir shot_upload_port.txt]
    set ::srv_log  [file join $dir shot_upload_srv.log]
    file delete -force $::srv_body $::srv_ce $::srv_port
    set f [open $::srv_script w]
    puts $f [string map [list @OUT@ $::srv_body @CE@ $::srv_ce @PORT@ $::srv_port] {
        proc conn {s a p} {
            fconfigure $s -translation binary
            set len 0; set ce none
            while {[gets $s line] > 0} {
                set line [string trimright $line \r]
                if {$line eq ""} break
                regexp -nocase {^content-length:\s*(\d+)} $line -> len
                regexp -nocase {^content-encoding:\s*(\S+)} $line -> ce
            }
            set body [read $s $len]
            set o [open @OUT@ wb]; puts -nonewline $o $body; close $o
            set o [open @CE@ w]; puts -nonewline $o $ce; close $o
            puts -nonewline $s "HTTP/1.1 200 OK\r\nContent-Length: 11\r\nConnection: close\r\n\r\n{\"ok\":true}"
            close $s; set ::done 1
        }
        set srv [socket -server conn -myaddr 127.0.0.1 0]
        set o [open @PORT@ w]; puts $o [lindex [fconfigure $srv -sockname] 2]; close $o
        after 20000 {set ::done 1}
        vwait ::done
    }]
    close $f
    set sh [auto_execok tclsh8.6]; if {$sh eq ""} {set sh [auto_execok tclsh]}
    exec {*}$sh $::srv_script >& $::srv_log &
    for {set i 0} {$i < 100 && ![file exists $::srv_port]} {incr i} {after 100}
    if {![file exists $::srv_port]} {
        set f [open $::srv_log]; set why [read $f]; close $f
        error "test server did not start: $why"
    }
    set f [open $::srv_port]; set port [string trim [read $f]]; close $f
    return $port
}
proc server_got {} {
    set f [open $::srv_body rb]; set body [read $f]; close $f
    set f [open $::srv_ce]; set ce [read $f]; close $f
    return [list $ce $body]
}
proc stop_server {} {
    file delete -force $::srv_body $::srv_ce $::srv_script $::srv_port $::srv_log
}

test shot-upload-curl-gzip-intact {TclCurl delivers gzip that inflates to the exact UTF-8 JSON} -constraints {tclcurl tclsh} -setup {
    set ::test_home [temporaryDirectory]
    set port [start_server]
} -body {
    set r [::plugins::shot_upload::post_json http://127.0.0.1:$port/support/api/shot_upload $json]
    lassign [server_got] ce got
    list [dict get $r ncode] $ce [expr {[zlib gunzip $got] eq $json_bytes}] \
        [expr {[string length $got] < [string length $json_bytes] / 4}] \
        [glob -nocomplain -directory $::test_home shot_upload_body_*.gz]
} -cleanup {
    stop_server
    set ::test_home /test/home
} -result {200 gzip 1 1 {}}

test shot-upload-curl-plain-when-no-tempfile {TclCurl sends plain UTF-8 JSON when the temp file can't be written} -constraints {tclcurl tclsh} -setup {
    set ::test_home /nonexistent/dir
    set port [start_server]
} -body {
    set r [::plugins::shot_upload::post_json http://127.0.0.1:$port/support/api/shot_upload $json]
    lassign [server_got] ce got
    list [dict get $r ncode] $ce [expr {$got eq $json_bytes}]
} -cleanup {
    stop_server
    set ::test_home /test/home
} -result {200 none 1}

set failed $::tcltest::numTests(Failed)
cleanupTests
if {$failed} {exit 1}
